# AutoSave watcher log (written on every auto-commit — must never be committed
# or it would trigger an endless loop of autosave commits)
tools/autosaver.log
tools/*.log
*.log
*.pt
*.onnx
__pycache__/
*.py[cod]

# Local Python environment for the YOLO vision daemon (multi-GB CUDA wheels —
# must never be committed/pushed)
.venv/
venv/

# Simulator persistent store (updates dynamically on each demo click)
prototype/data/simulation_store.json
prototype/.env.local

# Local Upstash CLI skill files
prototype/.agents/
prototype/skills-lock.json

.vercel/

# Android binaries (allow public demo APK for cloud distribution; ignore all other APK builds)
*.apk
!prototype/public/downloads/Arohasetu-Demo.apk


# Temporary scratch and review files
tmp/

# Presentation and Document Binaries (Local files only — never upload to Git)
*.pdf
*.pptx
*.ppt
